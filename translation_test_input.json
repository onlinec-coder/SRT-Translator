          "direct",
          "defiant"
        ]
      }
    },
    {
      "index": 6,
      "text": "You were never the one I wanted Vivienne.",
      "speaker": {
        "id": "C002",
        "name": "Lucian",
        "type": "character",
        "confidence": "high",
        "gender": "male",
