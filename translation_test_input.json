        "type": "narrator",
        "confidence": "high",
        "gender": null,
        "speech_style": [
          "Direct",
          "Analytical"
        ]
      }
    },
    {
      "index": 8,
      "text": "You threw yourself at me.\nI let it happen. That's all this ever was.",
